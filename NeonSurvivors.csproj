<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NeonSurvivors</RootNamespace>
    <!-- Keep the game (a single HTML file) at the repo root so GitHub Pages keeps working -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="neon-survivors.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
